{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prep-app.local/schema/lesson.schema.json",
  "title": "Lesson (SPEC 3.2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "version", "status", "title_vi", "est_minutes", "objectives_vi",
    "blocks", "problems", "mastery_check", "checkpoint", "source"
  ],
  "properties": {
    "id": {"$ref": "#/$defs/subtopic_id"},
    "version": {"type": "integer", "minimum": 1},
    "status": {"enum": ["draft", "validated", "reviewed", "published"]},
    "title_vi": {"type": "string", "minLength": 1},
    "est_minutes": {"type": "integer", "minimum": 8, "maximum": 15},
    "objectives_vi": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {"type": "string", "minLength": 1}
    },
    "blocks": {"type": "array", "items": {"$ref": "#/$defs/block"}},
    "problems": {
      "type": "object",
      "additionalProperties": false,
      "required": ["practice", "extra"],
      "properties": {
        "practice": {"$ref": "#/$defs/slug_list"},
        "extra": {"$ref": "#/$defs/slug_list"}
      }
    },
    "mastery_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["l1", "l2", "l3"],
      "properties": {
        "l1": {"$ref": "#/$defs/item_list"},
        "l2": {"$ref": "#/$defs/item_list"},
        "l3": {"$ref": "#/$defs/item_list"}
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass_ratio", "min_items"],
      "properties": {
        "pass_ratio": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "min_items": {"type": "integer", "minimum": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tree_hash", "authored_by", "reviewed_by", "date"],
      "properties": {
        "tree_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "authored_by": {"type": "string", "minLength": 1},
        "reviewed_by": {"type": ["string", "null"]},
        "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "draft"}}},
      "else": {"properties": {"blocks": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "subtopic_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "slug_list": {"type": "array", "items": {"$ref": "#/$defs/slug"}, "uniqueItems": true},
    "item_list": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[A-Z]\\d+$"},
      "uniqueItems": true
    },
    "block_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "md": {"type": "string", "minLength": 1},
    "block": {
      "oneOf": [
        {"$ref": "#/$defs/text"},
        {"$ref": "#/$defs/callout"},
        {"$ref": "#/$defs/code_sample"},
        {"$ref": "#/$defs/quiz_mcq"},
        {"$ref": "#/$defs/quiz_fill"},
        {"$ref": "#/$defs/predict_output"},
        {"$ref": "#/$defs/code_exercise"},
        {"$ref": "#/$defs/problem_ref"},
        {"$ref": "#/$defs/summary"}
      ]
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "md"],
      "properties": {
        "id": {"$ref": "#/$defs/block_id"},
        "type": {"const": "text"},
        "md": {"$ref": "#/$defs/md"}
      }
    },
    "callout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "kind", "md"],
      "properties": {
        "id": {"$ref": "#/$defs/block_id"},
        "type": {"const": "callout"},
        "kind": {"enum": ["tip", "warning", "beginner", "interview"]},
        "md": {"$ref": "#/$defs/md"}
      }
    },
    "code_sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "lang", "code", "runnable"],
      "properties": {
        "id": {"$ref": "#/$defs/block_id"},
        "type": {"const": "code_sample"},
        "lang": {"enum": ["python", "java"]},
        "code": {"type": "string", "minLength": 1},
        "runnable": {"type": "boolean"},
        "expected_output": {"type": "string"}
      }
    },
    "quiz_mcq": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "prompt_md", "options", "answer", "explain_md"],
      "properties": {
        "id": {"$ref": "#/$defs/block_id"},
        "type": {"const": "quiz_mcq"},
        "graded": {"type": "boolean"},
        "prompt_md": {"$ref": "#/$defs/md"},
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "text_md"],
            "properties": {
              "id": {"$ref": "#/$defs/block_id"},
              "text_md": {"$ref": "#/$defs/md"}
            }
          }
        },
        "answer": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/block_id"},
          "uniqueItems": true
        },
        "multi": {"type": "boolean"},
        "explain_md": {"$ref": "#/$defs/md"}
      }
    },
    "quiz_fill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "prompt_md", "blanks", "explain_md"],
      "properties": {
        "id": {"$ref": "#/$defs/block_id"},
        "type": {"const": "quiz_fill"},
        "graded": {"type": "boolean"},
        "prompt_md": {"$ref": "#/$defs/md"},
        "blanks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["accept"],
            "properties": {
              "accept": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              },
              "regex": {"type": "string"}
            }
          }
        },
        "explain_md": {"$ref": "#/$defs/md"}
      }
    },
    "predict_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "code", "expected_output", "explain_md"],
      "properties": {
        "id": {"$ref": "#/$defs/block_id"},
        "type": {"const": "predict_output"},
        "graded": {"type": "boolean"},
        "code": {"type": "string", "minLength": 1},
        "expected_output": {"type": "string"},
        "explain_md": {"$ref": "#/$defs/md"}
      }
    },
    "code_exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "md", "entry", "starter", "tests", "hint_md", "solution"],
      "properties": {
        "id": {"$ref": "#/$defs/block_id"},
        "type": {"const": "code_exercise"},
        "md": {"$ref": "#/$defs/md"},
        "entry": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "starter": {"type": "string", "minLength": 1},
        "tests": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["args", "expected"],
            "properties": {"args": {"type": "array"}, "expected": {}}
          }
        },
        "hint_md": {"$ref": "#/$defs/md"},
        "solution": {"type": "string", "minLength": 1}
      }
    },
    "problem_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "problem_id"],
      "properties": {
        "id": {"$ref": "#/$defs/block_id"},
        "type": {"const": "problem_ref"},
        "problem_id": {"$ref": "#/$defs/slug"}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "bullets_vi"],
      "properties": {
        "id": {"$ref": "#/$defs/block_id"},
        "type": {"const": "summary"},
        "bullets_vi": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
