{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prep-app.local/schemas/placement.schema.json",
  "title": "Placement-only items of one subtopic (mcq / read_code rungs, SPEC 5.6)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subtopic_id",
    "items"
  ],
  "properties": {
    "subtopic_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "difficulty",
        "type",
        "minutes",
        "prompt_md"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]\\d+$"
        },
        "difficulty": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "type": {
          "enum": [
            "write_code",
            "read_code",
            "concept",
            "mcq"
          ]
        },
        "minutes": {
          "type": "integer",
          "minimum": 1
        },
        "prompt_md": {
          "type": "string",
          "minLength": 1
        },
        "problem_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "expected_output": {
          "type": "string"
        },
        "answer_md": {
          "type": "string",
          "minLength": 1
        },
        "rubric_md": {
          "type": "string",
          "minLength": 1
        },
        "choices": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "answer_index": {
          "type": "integer",
          "minimum": 0
        },
        "explanation_md": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "write_code"
              }
            }
          },
          "then": {
            "required": [
              "problem_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "read_code"
              }
            }
          },
          "then": {
            "required": [
              "code",
              "expected_output"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "concept"
              }
            }
          },
          "then": {
            "required": [
              "answer_md"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "mcq"
              }
            }
          },
          "then": {
            "required": [
              "choices",
              "answer_index"
            ]
          }
        }
      ]
    }
  }
}
