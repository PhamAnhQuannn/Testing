{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prep-app.local/schemas/check.schema.json",
  "title": "Mastery check items of one subtopic (SPEC 3.4)",
  "type": "object",
  "additionalProperties": false,
  "required": ["subtopic_id", "items"],
  "properties": {
    "subtopic_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"},
    "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/item"}}
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "difficulty", "type", "minutes", "prompt_md"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z]\\d+$"},
        "difficulty": {"type": "integer", "minimum": 1, "maximum": 3},
        "type": {"enum": ["write_code", "read_code", "concept"]},
        "minutes": {"type": "integer", "minimum": 1},
        "concepts": {"type": "array", "items": {"type": "string"}, "maxItems": 4},
        "practices": {
          "type": "array",
          "items": {"type": "string", "enum": ["verify", "review", "measure"]},
          "maxItems": 3
        },
        "prompt_md": {"type": "string", "minLength": 1},
        "problem_id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
        "code": {"type": "string", "minLength": 1},
        "expected_output": {"type": "string"},
        "answer_md": {"type": "string", "minLength": 1},
        "rubric_md": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "write_code"}}},
          "then": {"required": ["problem_id"]}
        },
        {
          "if": {"properties": {"type": {"const": "read_code"}}},
          "then": {"required": ["code", "expected_output"]}
        },
        {
          "if": {"properties": {"type": {"const": "concept"}}},
          "then": {"required": ["answer_md"]}
        }
      ]
    }
  }
}
