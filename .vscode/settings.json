{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tools/tests", "apps/api/tests"],

  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },

  "eslint.workingDirectories": [{ "directory": "apps/web", "changeProcessCWD": true }],
  "typescript.tsdk": "apps/web/node_modules/typescript/lib",
  "vitest.rootConfig": "apps/web/vite.config.ts",

  "yaml.schemas": {
    "./content/schemas/lesson.schema.json": "content/lessons/**/*.yaml",
    "./content/schemas/problem.schema.json": "content/problems/**/problem.yaml",
    "./content/schemas/check.schema.json": "content/checks/**/*.yaml"
  },

  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/.venv": true,
    "apps/web/dist": true,
    "apps/web/public/pyodide": true,
    "uv.lock": true,
    "**/package-lock.json": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.venv/**": true,
    "apps/web/dist/**": true
  }
}
